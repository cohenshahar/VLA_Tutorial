<mujoco model="kr6">

  <compiler angle="radian"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <default>
    <joint limited="true" damping="10" armature="0.01"/>
    <position kp="300" ctrllimited="true"/>
    <geom contype="1" conaffinity="1"/>
  </default>

  <worldbody>
    <light name="sun" pos="1 1 3" dir="-0.3 -0.3 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>

    <!-- Base (fixed to world) -->
    <body name="base" pos="0 0 0">
      <geom name="base_col"  type="cylinder" size="0.110 0.06"  pos="0 0 0.06"  rgba="0.15 0.15 0.15 1"/>
      <geom name="base_post" type="capsule"  size="0.075" fromto="0 0 0.12 0 0 0.68" rgba="0.80 0.35 0.0 1"/>

      <!-- Link 1 : A1  base yaw (Z)  -- base height 700 mm -->
      <body name="link1" pos="0 0 0.700">
        <joint name="A1" axis="0 0 1" range="-2.967 2.967"/>
        <geom name="link1_hub" type="sphere"  size="0.090"                          rgba="0.80 0.35 0.0 1"/>
        <geom name="link1_arm" type="capsule" size="0.052" fromto="0 0 0 0.030 0 0" rgba="0.80 0.35 0.0 1"/>

        <!-- Link 2 : A2  shoulder pitch (Y)  -- upper arm 450 mm -->
        <body name="link2" pos="0.030 0 0">
          <joint name="A2" axis="0 1 0" range="-3.316 0.785"/>
          <geom name="link2_geom" type="capsule" size="0.050" fromto="0 0 0 0.450 0 0" rgba="0.80 0.35 0.0 1"/>

          <!-- Link 3 : A3  elbow pitch (Y)  -- elbow stub 50 mm -->
          <body name="link3" pos="0.450 0 0">
            <joint name="A3" axis="0 1 0" range="-2.094 2.722"/>
            <geom name="link3_hub"  type="sphere"  size="0.058"                         rgba="0.80 0.35 0.0 1"/>
            <geom name="link3_stub" type="capsule" size="0.042" fromto="0 0 0 0.050 0 0" rgba="0.80 0.35 0.0 1"/>

            <!-- Link 4 : A4  forearm roll (X)  -- forearm 300 mm -->
            <body name="link4" pos="0.050 0 0">
              <joint name="A4" axis="1 0 0" range="-3.229 3.229"/>
              <geom name="link4_geom" type="capsule" size="0.034" fromto="0 0 0 0 0 -0.300" rgba="0.55 0.55 0.55 1"/>

              <!-- Link 5 : A5  wrist pitch (Y)  -- wrist 80 mm -->
              <body name="link5" pos="0 0 -0.300">
                <joint name="A5" axis="0 1 0" range="-2.094 2.094"/>
                <geom name="link5_geom" type="capsule" size="0.026" fromto="0 0 0 0 0 -0.080" rgba="0.55 0.55 0.55 1"/>

                <!-- Link 6 : A6  flange roll (Z)  -- flange to EE -->
                <body name="link6" pos="0 0 -0.080">
                  <joint name="A6" axis="0 0 1" range="-6.109 6.109"/>
                  <!-- flange -->
                  <geom name="link6_geom"    type="cylinder" size="0.024 0.006"          pos="0 0  0.000" rgba="0.15 0.15 0.15 1"/>
                  <!-- suction cup: threaded body (gold) -->
                  <geom name="thread_body"   type="cylinder" size="0.015 0.018"          pos="0 0 -0.024" rgba="0.90 0.80 0.20 1"/>
                  <geom name="thread_r1"     type="cylinder" size="0.021 0.003"          pos="0 0 -0.009" rgba="0.90 0.80 0.20 1"/>
                  <geom name="thread_r2"     type="cylinder" size="0.021 0.003"          pos="0 0 -0.016" rgba="0.90 0.80 0.20 1"/>
                  <geom name="thread_r3"     type="cylinder" size="0.021 0.003"          pos="0 0 -0.023" rgba="0.90 0.80 0.20 1"/>
                  <geom name="thread_r4"     type="cylinder" size="0.021 0.003"          pos="0 0 -0.030" rgba="0.90 0.80 0.20 1"/>
                  <geom name="thread_r5"     type="cylinder" size="0.021 0.003"          pos="0 0 -0.037" rgba="0.90 0.80 0.20 1"/>
                  <!-- suction cup: purple neck -->
                  <geom name="cup_neck"      type="cylinder" size="0.011 0.010"          pos="0 0 -0.052" rgba="0.60 0.15 0.80 1"/>
                  <!-- suction cup: purple bell (wide flat dome) -->
                  <geom name="cup_bell_body" type="cylinder" size="0.022 0.008"          pos="0 0 -0.068" rgba="0.60 0.15 0.80 1"/>
                  <geom name="cup_bell_lip"  type="cylinder" size="0.027 0.003"          pos="0 0 -0.079" rgba="0.60 0.15 0.80 1"/>
                  <!-- ee site at suction face -->
                  <site name="ee_site" pos="0 0 -0.082" size="0.0012" rgba="1 0 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Position actuators -- one per joint -->
  <actuator>
    <position name="A1_pos" joint="A1" kp="500" ctrlrange="-2.967  2.967"/>
    <position name="A2_pos" joint="A2" kp="500" ctrlrange="-3.316  0.785"/>
    <position name="A3_pos" joint="A3" kp="500" ctrlrange="-2.094  2.722"/>
    <position name="A4_pos" joint="A4" kp="200" ctrlrange="-3.229  3.229"/>
    <position name="A5_pos" joint="A5" kp="200" ctrlrange="-2.094  2.094"/>
    <position name="A6_pos" joint="A6" kp="100" ctrlrange="-6.109  6.109"/>
  </actuator>

</mujoco>
